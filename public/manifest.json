{
  "manifest_version": 3,
  "name": "Motivational Anti-Distraction",
  "description": "Blocks distraction sites behind a motivational ceremony: daily budgets, a 30-second quote ritual, and honest usage stats.",
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Motivational Anti-Distraction",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["interstitial.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
